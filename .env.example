PORT=10000
API_KEY=
ALLOWED_ORIGINS=https://TU-PANEL.example,https://TU-PAGINA-BRIGADAS.example

# Acceso multiusuario. No guardes contraseñas reales en este archivo.
SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
SESSION_TTL_MS=43200000
BIOFILE_USERS_JSON=[{"id":"usuario-ejemplo","nombre":"USUARIO EJEMPLO","usuario":"USUARIO EJEMPLO","contrasena":"CONTRASENA_REAL_SOLO_EN_RENDER"}]

# Compatibilidad temporal con las páginas que todavía usan X-API-Key.
BIOFILE_USUARIO=
BIOFILE_CONTRASENA=

GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_HOJA=Hoja 1
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-service-account.json

DEFAULT_LOCALIDAD=
DEFAULT_SEDE=
DEFAULT_TIPO_EVALUACION=
DEFAULT_ZONA=URBANA
DEFAULT_ACUERDO=PARTICULARES
DEFAULT_EMPRESA_MISION=PARTICULARES
DEFAULT_PAQUETE=NO APLICA
DEFAULT_EPS=NO REFIERE
DEFAULT_AFP=NO REFIERE
DEFAULT_ARL=NO REFIERE

HEADLESS=true
RUNTIME_DIR=/tmp/biofile-robot
